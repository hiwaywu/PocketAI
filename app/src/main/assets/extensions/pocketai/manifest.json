{
  "manifest_version": 2,
  "name": "Pocket AI bridge",
  "version": "1.0",
  "description": "Lets Pocket AI read the open page's main text for the AI, and clear stuck overlays.",
  "browser_specific_settings": { "gecko": { "id": "pocketai-bridge@pocketai" } },
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons", "<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["Readability.js", "Readability-readerable.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
